# Base + Optimism reads (public RPC works for dev, get an Alchemy key for production)
BASE_RPC_URL=https://mainnet.base.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Empire Builder (public reads, no key needed for personal-stats / leaderboard)
EMPIRE_BUILDER_API=https://api.empirebuilder.world
ZABAL_EMPIRE_ADDRESS=0xe0faa499d6711870211505bd9ae2105206af1462

# Neynar (Farcaster identity - verified address lookup)
NEYNAR_API_KEY=

# EAS attestation signer - the wallet that signs attestations on the artist's behalf
# (or leave unset and sign client-side with the artist's own wallet instead - see server/routes/eas.js)
EAS_SIGNER_PRIVATE_KEY=

# WaveWarZ - no official API, this app scrapes the public intelligence dashboard
WAVEWARZ_SOURCE_URL=https://wavewarz-intelligence.vercel.app

PORT=3000
